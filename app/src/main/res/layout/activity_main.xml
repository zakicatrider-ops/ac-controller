<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◈ CLIMATRONIC v1.0 ◈"
        android:textColor="#A0AEC0"
        android:textSize="12sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="24dp"/>

    <!-- Temperature Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D0D1A"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/tvTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#63B3ED"
                android:textSize="64sp"
                android:fontFamily="monospace"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="°C"
                android:textColor="#4A90A4"
                android:textSize="20sp"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMPERATURE"
            android:textColor="#4A5568"
            android:textSize="10sp"
            android:letterSpacing="0.2"/>
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STANDBY"
        android:textColor="#4A5568"
        android:textSize="16sp"
        android:letterSpacing="0.15"
        android:layout_marginBottom="24dp"/>

    <!-- Toggle Button -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="⏻ TURN ON"
        android:textColor="#9AE6B4"
        android:textSize="14sp"
        android:backgroundTint="#276749"
        android:layout_marginBottom="16dp"/>

    <!-- Connection status -->
    <TextView
        android:id="@+id/tvConnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● ARDUINO DISCONNECTED"
        android:textColor="#4A5568"
        android:textSize="10sp"/>

</LinearLayout>
